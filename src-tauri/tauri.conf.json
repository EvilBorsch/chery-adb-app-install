{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesaySV APK Installer",
  "version": "1.0.0",
  "identifier": "local.desaysv.apk.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DesaySV APK Installer",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/localinstall.apk"],
    "category": "DeveloperTool",
    "shortDescription": "Install APK files on DesaySV Android head units"
  }
}
